# 复制到服务器 /srv/apps/dufesh/shared/config/postgres.env 并设置 chmod 600。
# 不要把真实密码提交到 Git。
POSTGRES_DB=dufesh
POSTGRES_USER=dufesh_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
PGDATA=/var/lib/postgresql/data/pgdata

# auth-api 只使用这个非 owner 运行角色。迁移、备份和维护继续使用上面的 owner。
AUTH_DB_USER=dufesh_runtime
AUTH_DB_PASSWORD=replace-with-a-different-long-random-password

# 离线教师/教材导入工具专用角色。它不能读取账号、会话、密码、MFA 或 OAuth 表。
IMPORT_DB_USER=dufesh_importer
IMPORT_DB_PASSWORD=replace-with-a-third-long-random-password
