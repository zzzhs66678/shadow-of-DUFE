# 复制到服务器 /srv/apps/dufesh/shared/config/postgres.env 并设置 chmod 600。
# 不要把真实密码提交到 Git。
POSTGRES_DB=dufesh
POSTGRES_USER=dufesh_app
POSTGRES_PASSWORD=replace-with-a-long-random-password
PGDATA=/var/lib/postgresql/data/pgdata

# 不可登录的 public 对象所有者，以及只在发布时使用的迁移登录角色。
MIGRATION_DB_ROLE=dufesh_schema_owner
MIGRATION_DB_USER=dufesh_migrator
MIGRATION_DB_PASSWORD=replace-with-a-migration-only-long-random-password

# auth-api 只使用这个非 owner 运行角色。维护与紧急恢复继续使用上面的 owner。
AUTH_DB_USER=dufesh_runtime
AUTH_DB_PASSWORD=replace-with-a-runtime-only-long-random-password

# 离线教师/教材导入工具专用角色。它不能读取账号、会话、密码、MFA 或 OAuth 表。
IMPORT_DB_USER=dufesh_importer
IMPORT_DB_PASSWORD=replace-with-a-third-long-random-password

# 备份专用只读角色。只能读取公开 schema 的表/序列，不能写入或执行函数。
BACKUP_DB_USER=dufesh_backup
BACKUP_DB_PASSWORD=replace-with-a-fourth-long-random-password
