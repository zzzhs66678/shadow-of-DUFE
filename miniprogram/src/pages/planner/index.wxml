<view class="page"><view class="eyebrow">{{readOnly ? '网站内容 · 供查看' : '保存在本机'}}</view><view class="title">日程与作业</view><view wx:if="{{readOnly && examNotice}}" class="notice">{{examNotice}}</view>
  <view wx:if="{{readOnly}}" class="muted">显示网站保存的日程与作业，编辑请在官网完成。</view>
  <view wx:if="{{!readOnly}}" class="row"><button class="primary" bindtap="begin" data-kind="task">添加作业</button><button class="quiet" bindtap="begin" data-kind="event">添加日程</button></view>
  <view wx:if="{{editing && !readOnly}}" class="card">
    <view class="course-title">{{draft.id ? '编辑' : '添加'}}{{draft.kind === 'task' ? '作业' : '日程'}}</view>
    <text class="label">标题</text><input class="field" value="{{draft.title}}" data-field="title" bindinput="field" maxlength="100" placeholder="写下要完成的事" aria-label="标题" />
    <text class="label">{{draft.kind === 'task' ? '截止日期' : '日期 / 首次日期'}}</text><picker mode="date" value="{{draft.date}}" data-field="date" bindchange="field"><view class="picker">{{draft.date}} ▾</view></picker>
    <block wx:if="{{draft.kind === 'event'}}"><text class="label">起止时间</text><view class="row"><picker mode="time" value="{{draft.startTime}}" data-field="startTime" bindchange="field"><view class="picker">{{draft.startTime}} ▾</view></picker><text>至</text><picker mode="time" value="{{draft.endTime}}" data-field="endTime" bindchange="field"><view class="picker">{{draft.endTime}} ▾</view></picker></view><text class="label">地点</text><input class="field" value="{{draft.location}}" data-field="location" bindinput="field" maxlength="100" aria-label="地点" /><view class="row between"><text>每周同一天重复</text><switch checked="{{draft.repeat === 'weekly'}}" color="#a52325" bindchange="repeatChange" /></view><block wx:if="{{draft.repeat === 'weekly'}}"><text class="label">重复结束日期</text><picker mode="date" value="{{draft.repeatUntil}}" data-field="repeatUntil" bindchange="field"><view class="picker">{{draft.repeatUntil || '请选择结束日期'}} ▾</view></picker></block></block>
    <text class="label">关联课程（选填）</text><picker range="{{courses}}" value="{{courseIndex}}" bindchange="courseChange"><view class="picker">{{draft.courseId && courseIndex === 0 ? '原关联课程（保留）' : courses[courseIndex]}} ▾</view></picker>
    <text class="label">备注（选填）</text><textarea class="notes-field" value="{{draft.notes}}" data-field="notes" bindinput="field" maxlength="1000" placeholder="补充要求或待办步骤" aria-label="备注" />
    <view class="row space"><button class="primary" bindtap="save">保存</button><button class="quiet" bindtap="cancel">取消</button></view>
  </view>
  <view class="row rule"><button class="{{filter === 'pending' ? 'primary' : 'quiet'}}" bindtap="filterChange" data-filter="pending">未完成</button><button class="{{filter === 'all' ? 'primary' : 'quiet'}}" bindtap="filterChange" data-filter="all">全部</button></view>
  <view wx:for="{{rows}}" wx:key="id" class="card"><view class="small red">{{item.kind === 'task' ? '作业' : item.kind === 'exam' ? '考试' : '日程'}} · {{item.completed ? '已完成' : item.dueLabel}}</view><view class="course-title">{{item.title}}</view><view wx:if="{{item.kind !== 'task'}}">{{item.startTime}}–{{item.endTime}} {{item.location}}</view><view class="muted">{{item.repeatLabel}}</view><view wx:if="{{item.courseTitle}}" class="muted">{{item.courseTitle}}</view><view wx:if="{{item.notes}}" class="planner-notes">{{item.notes}}</view><view wx:if="{{!readOnly}}" class="row space"><button wx:if="{{item.kind === 'task'}}" class="quiet" bindtap="toggle" data-id="{{item.id}}">{{item.completed ? '恢复未完成' : '标记完成'}}</button><button class="quiet" bindtap="edit" data-id="{{item.id}}">编辑</button><button class="quiet" bindtap="remove" data-id="{{item.id}}">删除</button></view></view>
  <view wx:if="{{!rows.length}}" class="empty"><view class="empty-title">暂时没有{{filter === 'pending' ? '未完成的' : ''}}安排</view><view class="muted">{{readOnly ? '可以到网站账号页重新读取最新内容。' : '从上方添加一项作业或日程。'}}</view></view>
</view>
