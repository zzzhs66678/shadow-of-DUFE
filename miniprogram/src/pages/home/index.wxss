/* Published mobile daily workspace: shared paper, compact time rail, then one next action. */
.home-page { padding: 28rpx 28rpx 64rpx; }
.home-head { align-items: center; gap: 24rpx; padding: 16rpx 0 30rpx; margin: 0 0 28rpx; border-bottom: 1rpx solid var(--dufe-ink); }
.home-date { color: var(--dufe-red); font-size: 24rpx; letter-spacing: .5rpx; }
.home-title-row { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin: 16rpx 0 24rpx; padding: 0 0 20rpx; border-bottom: 1rpx solid var(--dufe-ink); }
.home-title { font-size: 60rpx; margin: 0; padding: 0; border: 0; letter-spacing: -2rpx; }
.home-page button.home-search-entry { display: flex; align-items: center; justify-content: center; flex: 0 0 96rpx; width: 96rpx; min-height: 44px; padding: 10rpx 8rpx; border: 1rpx solid var(--dufe-line); border-radius: 8rpx; background: transparent; font-size: 24rpx; }
.home-term { font-size: 26rpx; line-height: 1.7; color: var(--dufe-muted); }
.campus-time { flex: 0 0 172rpx; width: 172rpx; padding: 0; }
.campus-time .small { font-size: 22rpx; }
.campus-clock { font-family: var(--dufe-display); font-size: 46rpx; margin-top: 16rpx; letter-spacing: -1.5rpx; }
.time-rail { margin-top: 32rpx; }
.time-dot { width: 12rpx; height: 12rpx; top: -6rpx; }
.campus-pins { gap: 16rpx; margin: 0 0 32rpx; }
.campus-pins button { background: transparent; border: 1rpx solid var(--dufe-line); border-radius: 16rpx; min-height: 44px; padding: 16rpx 6rpx; }
.campus-link-hint { color: var(--dufe-muted); font-size: 20rpx; font-weight: 400; margin-top: 2rpx; }
.home-section-head { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.home-section-head > view { display: flex; align-items: baseline; gap: 20rpx; min-width: 0; }
.home-section-head > text, .home-section-head > view > text:first-child { font-size: 26rpx; }
.home-page button.home-text-button { display: flex; align-items: center; justify-content: center; width: auto; min-height: 44px; padding: 8rpx 0; border: 0; border-radius: 0; background: transparent; font-size: 24rpx; color: var(--dufe-red); }
.home-week-hint { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; font-size: 24rpx; color: var(--dufe-muted); margin: 8rpx 0; }
.home-setup { border: 1rpx solid var(--dufe-line); border-left: 5rpx solid var(--dufe-red); border-radius: 12rpx; background: var(--dufe-paper-raised); padding: 40rpx; margin: 28rpx 0 40rpx; }
.home-setup .course-title { font-size: 40rpx; margin-bottom: 10rpx; }
.home-setup .muted { font-size: 28rpx; line-height: 1.8; }
.now-card { padding: 40rpx; margin: 28rpx 0 40rpx; border-radius: 0 88rpx 0 0; }
.now-header { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 10rpx; font-size: 26rpx; }
.now-body { display: flex; gap: 24rpx; align-items: flex-start; padding: 40rpx 0; }
.now-mark { display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; width: 72rpx; height: 72rpx; border: 1rpx solid var(--dufe-line); border-radius: 12rpx; color: var(--dufe-red); font-family: var(--dufe-display); font-size: 32rpx; background: var(--dufe-paper-deep); }
.now-copy { flex: 1; min-width: 0; }
.now-course { font-size: 46rpx; font-weight: 600; line-height: 1.4; margin: 0; letter-spacing: -1rpx; overflow-wrap: anywhere; }
.now-location { font-size: 28rpx; line-height: 1.8; margin: 16rpx 0 6rpx; overflow-wrap: anywhere; }
.home-actions { margin-top: 0; gap: 24rpx; }
.home-setup .home-actions { margin-top: 28rpx; }
.home-actions button { min-height: 44px; padding: 20rpx 8rpx; font-size: 28rpx; }
.home-assignment { background: var(--dufe-paper-deep); border: 1rpx solid var(--dufe-line); border-radius: 0 0 0 48rpx; margin: 0 0 40rpx; padding: 36rpx 40rpx; }
.home-assignment .course-title { font-family: var(--dufe-display); font-size: 42rpx; margin: 16rpx 0 8rpx; }
.home-assignment-actions { display: flex; gap: 28rpx; align-items: center; flex-wrap: wrap; }
.home-timeline { margin-top: 48rpx; }
.home-timeline > .home-section-head { padding-bottom: 16rpx; }
.agenda-row { gap: 18rpx; padding: 24rpx 0; }
.agenda-time { width: 126rpx; font-size: 24rpx; overflow-wrap: anywhere; }
.agenda-kind { color: var(--dufe-muted); font-size: 20rpx; margin-bottom: 4rpx; }
.agenda-title { font-weight: 600; font-size: 30rpx; }
.agenda-row button { width: auto; min-height: 44px; padding: 12rpx 18rpx; font-size: 24rpx; }
.agenda-row.past { opacity: .55; }
.home-agenda-empty { border-top: 1rpx solid var(--dufe-line); padding: 28rpx 0; color: var(--dufe-muted); font-size: 26rpx; }
.home-planner-link { margin: 10rpx 0 0; gap: 28rpx; }
.home-planner-link button { min-height: 44px; }
.home-footer { border-top: 1rpx solid var(--dufe-line); margin-top: 40rpx; padding-top: 24rpx; color: var(--dufe-muted); font-size: 22rpx; line-height: 1.7; }
.home-page .exam-notice { margin: 28rpx 0; padding: 18rpx 24rpx; }
.home-page .exam-date { width: 144rpx; font-size: 28rpx; }
.home-page .exam-copy .course-title { font-size: 30rpx; }
