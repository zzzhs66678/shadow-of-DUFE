<view class="page"><view class="eyebrow">个人中心</view><view class="title">我的</view><view class="subtitle">{{termLabel}} · {{readOnly ? '正在查看网站内容' : '正在使用本机内容'}}</view>
  <button class="quiet full" bindtap="account">{{user ? (user.displayName || user.username) + ' · 网站账号 →' : '登录网站账号 →'}}</button>
  <view class="profile-summary"><view><text class="profile-number">{{count}}</text><view class="muted">教学班</view></view><view><text class="profile-number">{{tasks}}</text><view class="muted">未完成作业</view></view><view><text class="profile-number">{{events}}</text><view class="muted">个人日程</view></view></view>
  <view class="rule"><button class="quiet full room-meeting" bindtap="timetable">我的课表 →</button><button class="quiet full room-meeting" bindtap="planner">日程与作业 →</button><button wx:if="{{!readOnly}}" class="quiet full room-meeting" bindtap="classes">按班级导入 →</button><button wx:if="{{!readOnly}}" class="quiet full room-meeting" bindtap="settings">学期与课表设置 →</button></view>
  <view class="rule"><view class="course-title">东财常用</view><view class="campus-pins"><button class="quiet" bindtap="copy" data-key="library">我去图书馆<view class="small muted">复制入口</view></button><button class="quiet" bindtap="copy" data-key="campusCard">校园码<view class="small muted">复制入口</view></button><button class="quiet" bindtap="copy" data-key="ginkgo">白果云<view class="small muted">复制入口</view></button></view><view class="muted small">复制后用浏览器打开；校园服务由相应平台提供。</view></view>
  <view class="rule muted">网站内容供查看，编辑请在官网完成。本机内容独立保留，不会自动覆盖网站课表。</view><button class="quiet full space" bindtap="about">项目与隐私说明 →</button>
</view>
