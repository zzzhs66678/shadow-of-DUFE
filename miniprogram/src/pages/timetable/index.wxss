/* Follow the published website's personal-timetable.module.css. */
.schedule-page { padding: 28rpx 24rpx 64rpx; }
.schedule-page .schedule-heading { gap: 16rpx; }
.schedule-page .schedule-heading .title { font-size: 48rpx; line-height: 1.25; }
.schedule-page .schedule-heading button { flex: 0 0 auto; width: auto; min-width: 0; min-height: 40px; padding: 10rpx 18rpx; }
.schedule-page .schedule-term { align-items: center; gap: 8rpx 18rpx; margin: 14rpx 0 20rpx; line-height: 1.5; }
.schedule-page .schedule-term text { max-width: 100%; overflow-wrap: break-word; }
.schedule-page .schedule-term button { width: auto; flex: 0 0 auto; min-height: 40px; padding: 10rpx 12rpx; }
.schedule-page .schedule-plan-bar { display: flex; align-items: stretch; gap: 12rpx; border-bottom: 1rpx solid var(--dufe-line); margin: 8rpx 0 18rpx; }
.schedule-page .schedule-term-picker { flex: 0 0 140rpx; width: 140rpx; }
.schedule-page .schedule-term-picker .picker { height: 100%; min-height: 44px; border: 0; background: transparent; font-size: 24rpx; padding: 18rpx 8rpx; }
.schedule-page .schedule-plan-scroll { flex: 1; width: 0; min-width: 0; }
.schedule-page .schedule-plan-tabs { display: flex; align-items: stretch; width: max-content; min-width: 100%; }
.schedule-page button.schedule-plan-tab { flex-shrink: 0; display: flex; align-items: center; gap: 12rpx; width: auto; max-width: 400rpx; min-height: 44px; padding: 16rpx 18rpx; background: transparent; border-radius: 0; border-bottom: 3rpx solid transparent; font-size: 24rpx; line-height: 1.4; color: var(--dufe-muted); }
.schedule-page button.schedule-plan-tab text { overflow-wrap: break-word; }
.schedule-page button.schedule-plan-tab.active { border-bottom-color: var(--dufe-red); color: var(--dufe-red); font-weight: 600; }
.schedule-page .schedule-plan-count { font-size: 20rpx; color: var(--dufe-muted); }
.schedule-page .notice { font-size: 24rpx; margin: 18rpx 0; }
.schedule-page .notice button { margin-top: 12rpx; min-height: 40px; padding: 12rpx 18rpx; font-size: 24rpx; }
.schedule-page .schedule-week-controls { gap: 12rpx; margin: 20rpx 0 12rpx; }
.schedule-page .schedule-week-controls button { flex: 0 0 auto; min-height: 44px; padding: 14rpx 18rpx; font-size: 24rpx; }
.schedule-page .schedule-week-controls picker { flex: 1; width: 0; min-width: 0; }
.schedule-page .schedule-week-controls .picker { display: flex; justify-content: center; align-items: center; min-height: 44px; padding: 14rpx 8rpx; font-size: 26rpx; }
.schedule-page .schedule-view-switch { gap: 0; padding-bottom: 4rpx; border-bottom: 1rpx solid var(--dufe-line); }
.schedule-page .schedule-view-switch button { flex: 0 0 116rpx; width: 116rpx; min-height: 40px; border: 0; border-bottom: 3rpx solid transparent; border-radius: 0; background: transparent; color: var(--dufe-muted); padding: 12rpx 10rpx; }
.schedule-page .schedule-view-switch button.primary { background: transparent; border-bottom-color: var(--dufe-red); color: var(--dufe-red); font-weight: 600; }
.schedule-page .schedule-grid-tools { flex-wrap: wrap; gap: 4rpx 16rpx; margin: 8rpx 0 10rpx; }
.schedule-page .schedule-source-legend { display: flex; align-items: center; gap: 8rpx; color: #514c45; font-size: 20rpx; }
.schedule-page .schedule-swatch { width: 18rpx; height: 18rpx; margin: 0; background: #ecd7d2; }
.schedule-page .official-swatch { background: var(--dufe-paper-raised); }
.schedule-page .schedule-grid-tools button { margin-left: auto; min-height: 40px; padding: 10rpx 0 10rpx 10rpx; font-size: 24rpx; color: #6a2929; }
.schedule-page .week-table { width: 100%; box-sizing: border-box; border-radius: 0; }
.schedule-page .week-heading { background: var(--dufe-paper); }
.schedule-page .week-heading .week-period { display: flex; align-items: center; justify-content: center; font-size: 20rpx; }
.schedule-page .week-period { box-sizing: border-box; flex: 0 0 56rpx; width: 56rpx; padding: 12rpx 0; }
.schedule-page .week-day { box-sizing: border-box; flex: 1 1 0%; width: 0; font-size: 22rpx; padding: 14rpx 0; line-height: 1.4; }
.schedule-page .week-day.today { color: var(--dufe-red); font-weight: 700; border-bottom: 3rpx solid var(--dufe-red); }
.schedule-page .week-row { min-height: 160rpx; align-items: stretch; }
.schedule-page .schedule-block-number { font-size: 32rpx; margin-bottom: 8rpx; }
.schedule-page .schedule-period-label { font-size: 18rpx; line-height: 1.4; }
.schedule-page .week-cell { box-sizing: border-box; flex: 1 1 0%; width: 0; min-width: 0; padding: 4rpx; }
.schedule-page .week-cell.conflict { background: var(--dufe-red-soft); }
.schedule-page button.week-course { display: flex; flex-direction: column; align-items: stretch; gap: 6rpx; width: 100%; min-width: 0; height: auto; min-height: 44px; box-sizing: border-box; border: 1rpx solid #cfc8bb; border-left: 4rpx solid #a62126; border-radius: 0; padding: 8rpx 4rpx; margin: 0 0 4rpx; background: #ecd7d2; color: #211f1b; text-align: left; line-height: 1.4; overflow: visible; }
.schedule-page button.academic-course { background: var(--dufe-paper-raised); }
.schedule-page .schedule-course-name { display: block; font-size: 22rpx; font-weight: 650; line-height: 1.4; white-space: normal; overflow-wrap: anywhere; }
.schedule-page .week-location, .schedule-page .week-teacher { font-size: 20rpx; font-weight: 400; line-height: 1.4; color: #514c45; margin: 0; white-space: normal; overflow-wrap: anywhere; }
.schedule-page .week-location { color: #211f1b; }
.schedule-page .week-weeks { font-size: 18rpx; font-weight: 400; line-height: 1.35; color: #514c45; margin: 0; overflow-wrap: anywhere; }
.schedule-page .schedule-conflict-label { font-size: 18rpx; line-height: 1.4; color: var(--dufe-red-deep); padding: 4rpx 0; overflow-wrap: break-word; }
.schedule-page .week-free { padding: 20rpx 0; }
.schedule-page .schedule-footnote { color: var(--dufe-muted); font-size: 22rpx; margin-top: 20rpx; }
.schedule-page .chips { grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 6rpx; }
.schedule-page button.chip { min-height: 44px; padding: 14rpx 0; font-size: 22rpx; }
.schedule-page .schedule-day-card { border-radius: 0; padding: 24rpx; }
.schedule-page button.schedule-day-main { display: block; width: 100%; min-height: 44px; padding: 0; border: 0; border-radius: 0; background: transparent; text-align: left; white-space: normal; }
.schedule-page .schedule-day-main .course-title { margin-top: 10rpx; }
.schedule-page .schedule-local-actions { margin-top: 28rpx; }
.schedule-page .schedule-local-actions button { flex: 1; width: 0; min-width: 0; padding: 20rpx 12rpx; font-size: 26rpx; }
@media (max-width: 350px) {
  .schedule-page { padding-left: 18rpx; padding-right: 18rpx; }
  .schedule-page .week-period { flex-basis: 48rpx; width: 48rpx; }
  .schedule-page .seven-day-table .week-cell { padding: 3rpx 1rpx; }
  .schedule-page .seven-day-table button.week-course { padding-left: 2rpx; padding-right: 2rpx; }
  .schedule-page .seven-day-table .schedule-course-name { font-size: 20rpx; }
  .schedule-page .seven-day-table .week-location, .schedule-page .seven-day-table .week-teacher { font-size: 18rpx; }
}
