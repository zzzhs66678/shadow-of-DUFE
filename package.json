{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "node server.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "typecheck": "tsc --noEmit",
    "audit:css": "node scripts/audit-css-cascade.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:responsive": "playwright test tests/e2e/responsive.spec.ts",
    "test:browser": "playwright test",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .codex_tmp --ignore-pattern outputs --ignore-pattern work --ignore-pattern test-results --ignore-pattern playwright-report --ignore-pattern blob-report",
    "build:course-core": "node scripts/build-course-core.mjs",
    "db:generate": "drizzle-kit generate",
    "import:academic:preflight": "node scripts/academic-import-preflight.mjs",
    "import:academic:write": "node scripts/academic-import-apply.mjs",
    "xiaoying:x0": "node xiaoying-executor/bin/server.mjs",
    "xiaoying:x1": "node xiaoying-executor/bin/server.mjs",
    "xiaoying:x1:lan": "node xiaoying-executor/bin/lan-server.mjs",
    "xiaoying:protocol": "node xiaoying-executor/bin/protocol-config.mjs",
    "test:xiaoying": "node --test tests/xiaoying-executor.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "drizzle-orm": "0.45.2",
    "html-to-image": "^1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-loading-skeleton": "3.5.0",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "next": "16.2.12",
    "pg": "^8.16.3",
    "react-server-dom-webpack": "19.2.8",
    "read-excel-file": "^9.3.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "fast-uri": "3.1.5",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
