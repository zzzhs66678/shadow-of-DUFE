(dufesh_proxy) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"

		Strict-Transport-Security "max-age=86400"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
	}

	@course_data path /data/*
	header @course_data Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	@site_images path /images/*
	header @site_images Cache-Control "public, max-age=604800, immutable"

	@compiled_assets path /assets/* /_next/static/*
	header @compiled_assets Cache-Control "public, max-age=31536000, immutable"

	@security_text path /.well-known/security.txt
	header @security_text >Content-Type "text/plain; charset=utf-8"

	handle /api/catalog/* {
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /resources/files/uploads/* {
		uri replace /resources/files/uploads/ /api/catalog/files/
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/auth/* {
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/admin/* {
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/community/* {
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@material_bookmarks path /api/material-bookmarks /api/material-bookmarks/*
	handle @material_bookmarks {
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@teacher_api path /api/teachers /api/teachers/*
	handle @teacher_api {
		reverse_proxy production-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	redir /campus-lab /campus-lab/ 308

	handle_path /campus-lab/* {
		header {
			Cache-Control "no-store"
			X-Frame-Options "DENY"
			X-Robots-Tag "noindex, nofollow, noarchive"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy production-xiaoying:43120 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle_path /resources/files/* {
		root * /srv/resources
		header Cache-Control "public, max-age=3600"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"
		file_server
	}

	handle {
		reverse_proxy production-app:3000
	}
}

dufesh.cn {
	import dufesh_proxy
}

www.dufesh.cn {
	@authentication_submit {
		method POST PUT PATCH DELETE
		path /api/* /campus-lab/*
	}
	route {
		respond @authentication_submit 403
		redir https://dufesh.cn{uri} 308
	}
}

http://dufesh.cn, http://www.dufesh.cn, http://112.126.75.74 {
	@authentication_submit {
		method POST PUT PATCH DELETE
		path /api/* /campus-lab/*
	}
	route {
		respond @authentication_submit 403
		redir https://dufesh.cn{uri} 308
	}
}

# The public staging hostname shares this edge gateway, but its app and auth
# containers remain isolated behind staging-only network aliases.
staging.dufesh.cn {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}

	handle /api/catalog/* {
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /resources/files/uploads/* {
		uri replace /resources/files/uploads/ /api/catalog/files/
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/auth/* {
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/admin/* {
		header Cache-Control "no-store"
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle /api/community/* {
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@material_bookmarks path /api/material-bookmarks /api/material-bookmarks/*
	handle @material_bookmarks {
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	@teacher_api path /api/teachers /api/teachers/*
	handle @teacher_api {
		reverse_proxy staging-auth-api:3100 {
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	handle {
		reverse_proxy staging-app:3000
	}
}
