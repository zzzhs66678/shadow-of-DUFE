(dufesh_proxy) {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		X-XSS-Protection "0"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https:; font-src 'self' data:; media-src 'self'; connect-src 'self'; frame-src 'self'; worker-src 'self' blob:; manifest-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
	}

	@course_data path /data/*
	header @course_data Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	@site_images path /images/*
	header @site_images Cache-Control "public, max-age=604800, immutable"

	@compiled_assets path /assets/* /_next/static/*
	header @compiled_assets Cache-Control "public, max-age=31536000, immutable"

	@security_text path /.well-known/security.txt
	header @security_text >Content-Type "text/plain; charset=utf-8"

	handle /api/auth/* {
		reverse_proxy auth-api:3100
	}

	handle /api/admin/* {
		header {
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		reverse_proxy auth-api:3100
	}

	handle /api/community/* {
		reverse_proxy auth-api:3100
	}

	redir /campus-lab /campus-lab/ 308

	handle_path /campus-lab/* {
		header {
			Cache-Control "no-store"
			X-Frame-Options "DENY"
			X-Robots-Tag "noindex, nofollow, noarchive"
			Referrer-Policy "no-referrer"
		}
		reverse_proxy xiaoying:43120
	}

	handle_path /resources/files/* {
		root * /srv/resources
		header Cache-Control "public, max-age=3600"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}

dufesh.cn {
	import dufesh_proxy
}

www.dufesh.cn {
	redir https://dufesh.cn{uri} 308
}

http://112.126.75.74 {
	import dufesh_proxy
}
