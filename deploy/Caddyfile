(dufesh_proxy) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}

	@course_data path /data/*
	header @course_data Cache-Control "public, max-age=3600, stale-while-revalidate=86400"

	@site_images path /images/*
	header @site_images Cache-Control "public, max-age=604800, immutable"

	handle /api/auth/* {
		reverse_proxy auth-api:3100
	}

	handle_path /resources/files/* {
		root * /srv/resources
		header Cache-Control "public, max-age=3600"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"
		file_server
	}

	handle {
		reverse_proxy app:3000
	}
}

dufesh.cn, www.dufesh.cn {
	import dufesh_proxy
}

http://112.126.75.74 {
	import dufesh_proxy
}
