# Copy to the server's 600-permission xiaoying.env. Never commit real values.
# Empty secrets deliberately make the production service fail closed until configured.
XIAOYING_MASTER_KEY=
XIAOYING_DEFAULT_INVITE_CODE=
XIAOYING_DEFAULT_INVITE_MAX_USES=20

# Keep TLS certificate verification enabled; 0 is rejected.
NODE_TLS_REJECT_UNAUTHORIZED=1

# Actual Caddy socket peer only, never 0.0.0.0/0.
XIAOYING_TRUSTED_PROXY_CIDRS=
