# 复制到服务器 /srv/apps/dufesh/shared/config/auth.env 并设置 chmod 600。
# AUTH_TOKEN_PEPPER 使用至少 32 字节随机值。空值会让服务拒绝启动。
AUTH_TOKEN_PEPPER=
AUTH_ALLOWED_ORIGINS=https://dufesh.cn,https://www.dufesh.cn
AUTH_SESSION_COOKIE=__Host-dufesh_session
AUTH_DEVICE_COOKIE=__Host-dufesh_device
AUTH_OAUTH_COOKIE=__Host-dufesh_oauth
AUTH_SESSION_MAX_AGE_SECONDS=2592000
AUTH_DEVICE_MAX_AGE_SECONDS=31536000
AUTH_OAUTH_TTL_SECONDS=600
AUTH_DB_POOL_MAX=10
AUTH_PUBLIC_ORIGIN=https://dufesh.cn

# 用户名、邮箱和密码是微信资质缺失时仍可使用的正式登录方式。
# 密码使用 Argon2id；生产环境的重置邮件通道接入前保持 disabled。
AUTH_CREDENTIALS_ENABLED=true
# 独立原生客户端登录与只读云端快照；完成接入/验收后显式开启。
AUTH_MINIPROGRAM_ENABLED=false
# Existing website accounts only; enable after migration 0033 and controlled
# real-WeChat verification. AppSecret stays in the server's 0600 environment.
# This is independent from the older browser OAuth mock mode below.
AUTH_MINIPROGRAM_WECHAT_ENABLED=false
AUTH_MINIPROGRAM_WECHAT_APP_ID=
AUTH_MINIPROGRAM_WECHAT_APP_SECRET=
# 自动读取用户本学期正式课表与考试安排；只在服务器内存中处理教务凭据。
# 部署前须确认服务器可以访问 vpn.dufe.edu.cn 与 WebVPN 教务代理。
AUTH_ACADEMIC_IMPORT_ENABLED=false
# 启用smtp前先应用0029；只向事先已验证邮箱签发重置令牌。
# 历史未验证邮箱不自动升级，旧用户登录不受影响。
AUTH_PASSWORD_RESET_MODE=disabled
AUTH_PASSWORD_RESET_TTL_SECONDS=1800

# 邮箱验证投递通道接入前保持 disabled。response 只允许本地开发，生产启动会拒绝。
# 旧用户补验证要求当前密码、当前登录会话和邮箱令牌；退出后须重新申请。
AUTH_EMAIL_VERIFICATION_MODE=disabled
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400

# 生产投递启用后，把上面两个 MODE 按需改为 smtp，并配置支持 TLS 的服务商。
# 465 使用 AUTH_SMTP_SECURE=true；587 使用 false，客户端仍强制 STARTTLS。
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_EMAIL_FROM=

# 管理后台默认关闭。启用前生成独立的 32 字节 base64 密钥与恢复码 pepper：
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 密钥只保存在 chmod 600 的服务器环境文件。新增 key ID 后可逐个重绑再移除旧 key。
AUTH_ADMIN_ENABLED=false
AUTH_ADMIN_COOKIE=__Host-dufesh_admin_elevation
AUTH_ADMIN_MFA_ACTIVE_KEY_ID=
AUTH_ADMIN_MFA_KEYS={}
AUTH_ADMIN_RECOVERY_PEPPER=
AUTH_ADMIN_ELEVATION_TTL_SECONDS=600

# 正式发布保持 disabled。mock 只允许受控开发或 staging，并必须使用独立随机密钥；
# 当前代码没有 real 模式，微信审核与真实适配完成前不得伪装为正式登录。
AUTH_WECHAT_MODE=disabled
AUTH_MOCK_LOGIN_SECRET=

# Email-verified registration (enable only after migration and controlled delivery test).
AUTH_REGISTRATION_MODE=disabled
AUTH_REGISTRATION_HMAC_KEY=
# Actual Caddy socket peer only; update after container recreation.
AUTH_TRUSTED_PROXY_CIDRS=

# Keep TLS certificate verification enabled; 0 is rejected.
NODE_TLS_REJECT_UNAUTHORIZED=1
# Optional private staging + published learning files; the API owns this
# directory and the web server exposes only its published subdirectory.
AUTH_CATALOG_UPLOAD_DIR=
